{
  "name": "coc-bot-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "format": "prettier --write src tests *.ts *.json",
    "format:check": "prettier --check src tests *.ts *.json"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.0",
    "@mdi/js": "^7.4.47",
    "@mdi/react": "^1.6.1",
    "@tauri-apps/api": "^2.12.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.58.0",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
  }
}
