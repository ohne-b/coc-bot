{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CoC Bot",
  "identifier": "app.ohne-b.coc-bot",
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/ohne-b/coc-bot/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVGRUQ0RjE5QTUzODVDNTkKUldSWlhEaWxHVS90N3pVOUYzOWNWVkJpbmJCWTkwWi9XY05lUDVxNThUcGxQeVgra0xIL1NpMDQK",
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  },
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev",
    "beforeBuildCommand": "npm --prefix frontend run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "CoC Bot", "width": 1200, "height": 800, "minWidth": 360, "minHeight": 480, "backgroundColor": "#181818" }],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:5173 ws://127.0.0.1:5173; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "ohne-b",
    "category": "Utility",
    "icon": ["icons/icon.ico"],
    "resources": {
      "../assets/config.json": "config.json",
      "../assets/calibration/english/": "calibration/english/",
      "../assets/calibration/digits/": "calibration/digits/",
      "../LICENSE.md": "LICENSE.md",
      "../NOTICE.md": "NOTICE.md",
      "../frontend/public/licenses/": "licenses/"
    },
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["English"], "displayLanguageSelector": false } }
  }
}
